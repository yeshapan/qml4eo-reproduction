# macOS Specific
.DS_Store
.AppleDouble
.LSOverride

# Project data & weights (massive dataset may bloat/fail git repo)
# ignore all data files, but keep the folder structure
data/*
!data/.gitkeep

# ignore saved model weights
*.pt
*.pth
*.h5

# python & environments
__pycache__/
*.py[cod]
*$py.class

# virtual environments
venv/
env/
qml_env/
.venv/

# Environment variables (secrets/API keys)
.env

# Jupyter notebooks
.ipynb_checkpoints/

# IDEs or editors
.vscode/
.idea/
.gemini/
.antigravity/